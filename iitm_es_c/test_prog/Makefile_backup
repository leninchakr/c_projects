# ---------- Toolchain ----------
CC	:= gcc
CFLAGS	:= -Wall -Wextra --std=c17 -Wpedantic -MMD -MP 
LDFLAGS  :=

# ---------- Layout ----------
SRC_DIR := src
BUILD_DIR := build
TARGET := $(BUILD_DIR)/main

# ---------- Sources / objects ----------
SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/%.o, $(SRCS))
DEPS := $(OBJS:.o=.d)

# ---------- Phony ----------
.PHONY: all run clean checkpatch test_all 

# ---------- Default ----------
all: $(TARGET)

# ---------- Link ----------
$(TARGET): $(OBJS)
	$(CC) $^ -o $@ $(LDFLAGS)

# ---------- Compile ----------
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

# ---------- Run ---------
run: $(TARGET)
	./$(TARGET)

# ---------- Clean ----------
clean:
	rm -rf $(BUILD_DIR)

# ---------- Kernel Syntax Check ----------
checkpatch:
	@echo "============================================="
	@echo " Running Linux Kernel Style Check..."
	@echo "============================================="
	@find src include test -maxdepth 3 -type f \( -name "*.c" -o -name "*.h" \) 2>/dev/null \
		-exec ./scripts/checkpatch.pl --no-tree -f --strict {} + || true
	@echo "============================================="
	@echo " Style verification complete."
	@echo "============================================="



-include $(DEPS)
